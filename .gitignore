# ==========================================
# NetBeans & Java .gitignore
# SQL Tutor - Grade 11 IT PAT Project
# ==========================================

# Compiled Java class files
*.class

# Maven build directory (compiled classes and reports)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# NetBeans user private settings and build folders
**/nbproject/private/
**/nbproject/project.properties.private
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Runtime student working databases and test data
users/

# Log and crash dump files
*.log
hs_err_pid*
replay_pid*

# Backup and temporary files
*.bak
*.tmp
*~
*.swp

# OS generated metadata
.DS_Store
Thumbs.db

# Other IDE configs (IntelliJ / VS Code)
.idea/
*.iml
.vscode/

# Archive and package files
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Output application executable jar
SQLTutor.jar

# Keep the bundled UCanAccess library jar needed for the project
!ucanaccess-5.1.8-uber.jar
